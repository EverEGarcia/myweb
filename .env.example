# ─────────────────────────────────────────────────────────────
# myWeb Portfolio — Environment Variables Example
# Owner: Ever Eslí  |  Contact: everesliga@gmail.com
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets to Git.
# ─────────────────────────────────────────────────────────────

# ── Application metadata ─────────────────────────────────────
# Used for canonical URL and Open Graph metadata.
# Set by the Pages workflow to the repository project-site URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to /myweb only for GitHub Pages project-site builds.
NEXT_PUBLIC_BASE_PATH=

# ── Contact API (Phase 2; set after deployment) ───────────────
# Public API endpoint URL, not a credential. Empty until deployed.
NEXT_PUBLIC_CONTACT_API_URL=

# Exact API Gateway CORS origins.
PORTFOLIO_ORIGIN=https://everegarcia.github.io
DEVELOPMENT_ORIGIN=http://localhost:3000

# ── Social links ─────────────────────────────────────────────
# LinkedIn is hardcoded in profile.ts (verified canonical URL).

# ── Scheduling CTA ───────────────────────────────────────────
# If empty, the "Schedule a conversation" button scrolls to #contact.
NEXT_PUBLIC_SCHEDULING_URL=

# ─────────────────────────────────────────────────────────────
# Phase 2 Lambda/CDK configuration — NEVER use NEXT_PUBLIC_ for these values
# ─────────────────────────────────────────────────────────────

# SES region. Verify the intended sender identity manually before deployment.
SES_REGION=us-east-1

# Intended From address. Manually verify this identity in SES before deployment;
# this example does not assert that verification has occurred.
SES_FROM_ADDRESS=everesliga@gmail.com

# Destination for contact form notification emails.
NOTIFICATION_EMAIL=everesliga@gmail.com

# CDK and the SESv2 client use SES_REGION above. Lambda credentials come from
# its execution role; no static AWS credentials are needed.
